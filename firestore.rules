rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Funções auxiliares ----------
    function logado() {
      return request.auth != null;
    }

    function perfilDe(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    // Conta liberada pela coordenação (contas novas e desativadas ficam de fora)
    function ativo() {
      return logado() && perfilDe(request.auth.uid).get('ativo', false) == true;
    }

    function ehSupervisor() {
      return ativo() && perfilDe(request.auth.uid).cargo == 'supervisor';
    }

    // Perfis de usuário
    match /users/{uid} {
      allow read: if logado() && (request.auth.uid == uid || ehSupervisor());
      // Toda conta nasce Professor e inativa. Só o Supervisor libera ou muda cargo.
      allow create: if logado()
                    && request.auth.uid == uid
                    && request.resource.data.cargo == 'professor'
                    && request.resource.data.ativo == false;
      allow update: if ehSupervisor();
      allow delete: if false;
    }

    // Banco de questões
    match /questoes/{id} {
      allow read: if ativo();

      allow create: if ativo()
                    && request.resource.data.criadoPorUid == request.auth.uid
                    && request.resource.data.cargo == perfilDe(request.auth.uid).cargo
                    && request.resource.data.criadoPor == perfilDe(request.auth.uid).nome
                    && request.resource.data.ultimaModificacaoPor == perfilDe(request.auth.uid).nome
                    && request.resource.data.statusValidacao == 'pendente'
                    && request.resource.data.get('arquivada', false) == false
                    && request.resource.data.get('responsavelUid', request.auth.uid) == request.auth.uid
                    && request.resource.data.keys().hasAll([
                         'segmento', 'ano', 'disciplina', 'bimestre', 'assunto',
                         'tipo', 'dificuldade', 'enunciado', 'gabarito', 'justificativa',
                         'criadoPor', 'criadoEm', 'ultimaModificacaoPor'
                       ])
                    && request.resource.data.segmento in ['fundamental', 'medio']
                    && request.resource.data.tipo in ['multipla_escolha', 'discursiva']
                    && request.resource.data.dificuldade in ['facil', 'media', 'dificil']
                    && request.resource.data.bimestre in [1, 2, 3, 4]
                    && request.resource.data.enunciado is string
                    && request.resource.data.enunciado.size() <= 4000;

      // A autoria nunca muda. O responsável só mexe em questão que ainda não foi aprovada
      // (e ela volta para 'pendente'). Aprovar, devolver, arquivar e transferir: só o Supervisor.
      allow update: if ativo()
                    && request.resource.data.criadoPorUid == resource.data.criadoPorUid
                    && request.resource.data.criadoEm == resource.data.criadoEm
                    && request.resource.data.cargo == resource.data.cargo
                    && request.resource.data.criadoPor == resource.data.criadoPor
                    && request.resource.data.ultimaModificacaoPor == perfilDe(request.auth.uid).nome
                    && (
                      ehSupervisor()
                      || (
                        resource.data.get('responsavelUid', resource.data.criadoPorUid) == request.auth.uid
                        && resource.data.statusValidacao != 'aprovada'
                        && request.resource.data.statusValidacao == 'pendente'
                        && request.resource.data.get('arquivada', false) == resource.data.get('arquivada', false)
                        && request.resource.data.get('responsavelUid', resource.data.criadoPorUid)
                             == resource.data.get('responsavelUid', resource.data.criadoPorUid)
                      )
                    );

      // Questão aprovada pertence ao Banco Oficial: só o Supervisor exclui.
      allow delete: if ativo()
                    && (
                      ehSupervisor()
                      || (
                        resource.data.get('responsavelUid', resource.data.criadoPorUid) == request.auth.uid
                        && resource.data.statusValidacao != 'aprovada'
                      )
                    );
    }

    // Imagens (guardadas como texto base64, já reduzidas pelo navegador)
    match /imagens/{id} {
      allow read: if ativo();
      allow create: if ativo()
                    && request.resource.data.criadoPorUid == request.auth.uid
                    && request.resource.data.dataUrl is string
                    && request.resource.data.dataUrl.size() <= 450000
                    && request.resource.data.alt is string
                    && request.resource.data.alt.size() >= 5
                    && request.resource.data.alt.size() <= 500;
      allow update: if false;
      allow delete: if ehSupervisor();
    }

    // Textos de apoio compartilhados por várias questões
    match /textosApoio/{id} {
      allow read: if ativo();
      allow create: if ativo()
                    && request.resource.data.criadoPorUid == request.auth.uid
                    && request.resource.data.titulo is string
                    && request.resource.data.titulo.size() >= 3
                    && request.resource.data.texto is string
                    && request.resource.data.texto.size() <= 12000;
      allow update, delete: if ehSupervisor();
    }

    // Provas salvas (guardam só os códigos das questões, o valor e as opções de impressão)
    match /provas/{id} {
      allow read: if ativo();
      allow create: if ativo()
                    && request.resource.data.criadoPorUid == request.auth.uid
                    && request.resource.data.titulo is string
                    && request.resource.data.titulo.size() >= 3
                    && request.resource.data.questoesIds is list
                    && request.resource.data.questoesIds.size() <= 100;
      allow update: if ativo()
                    && (resource.data.criadoPorUid == request.auth.uid || ehSupervisor())
                    && request.resource.data.criadoPorUid == resource.data.criadoPorUid
                    && request.resource.data.questoesIds.size() <= 100;
      allow delete: if ativo() && (resource.data.criadoPorUid == request.auth.uid || ehSupervisor());
    }

    // Trilha de auditoria: só se grava e só o Supervisor lê. Nunca se altera ou apaga.
    match /auditoria/{id} {
      allow read: if ehSupervisor();
      allow create: if ativo()
                    && request.resource.data.usuarioUid == request.auth.uid
                    && request.resource.data.usuarioNome == perfilDe(request.auth.uid).nome;
      allow update, delete: if false;
    }
  }
}
