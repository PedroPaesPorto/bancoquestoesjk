rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function logado() {
      return request.auth != null;
    }

    function cargoDe(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.cargo;
    }

    function ehSupervisor() {
      return logado() && cargoDe(request.auth.uid) == 'supervisor';
    }

    // Perfis de usuário
    match /users/{uid} {
      allow read: if logado() && (request.auth.uid == uid || ehSupervisor());
      // Todo mundo nasce Professor. Só o Supervisor promove alguém (ou você, pelo Console do Firebase).
      allow create: if logado()
                    && request.auth.uid == uid
                    && request.resource.data.cargo == 'professor';
      allow update: if ehSupervisor();
      allow delete: if false;
    }

    // Banco de questões
    match /questoes/{id} {
      allow read: if logado();
      allow create: if logado()
                    && request.resource.data.criadoPorUid == request.auth.uid
                    && request.resource.data.statusValidacao == 'pendente';
      allow update: if logado() && (
                      (resource.data.criadoPorUid == request.auth.uid
                        && request.resource.data.criadoPorUid == resource.data.criadoPorUid
                        && request.resource.data.statusValidacao == 'pendente')
                      || ehSupervisor()
                    );
      allow delete: if logado() && (resource.data.criadoPorUid == request.auth.uid || ehSupervisor());
    }

    // Trilha de auditoria: só se grava e só o Supervisor lê. Nunca se altera ou apaga.
    match /auditoria/{id} {
      allow read: if ehSupervisor();
      allow create: if logado() && request.resource.data.usuarioUid == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
